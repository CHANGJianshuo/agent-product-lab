{
  "name": "source-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "demo": "node demo/generate-demo.mjs",
    "demo:capture": "node demo/capture-live-analysis.mjs",
    "demo:live": "npm run demo:capture && node demo/generate-demo.mjs --live",
    "demo:record-product": "node demo/record-product-demo.mjs",
    "demo:edit-product": "node demo/edit-product-demo.mjs",
    "demo:product": "npm run demo:record-product && npm run demo:edit-product",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
