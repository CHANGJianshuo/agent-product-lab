# DeepSeek stays server-side. Never expose this value through a VITE_* variable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLANNING_MODEL=deepseek-v4-flash
DEEPSEEK_JUDGMENT_MODEL=deepseek-v4-pro

PORT=8787
MAX_CLAIMS=5
SEARCH_RESULTS_PER_QUERY=3
MAX_EVIDENCE_PER_CLAIM=8
ANALYSIS_RATE_LIMIT=30
